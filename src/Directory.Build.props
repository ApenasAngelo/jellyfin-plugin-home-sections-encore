<Project>
  <!-- Encore: own assembly name (and so its own config XML), without editing the upstream .csproj.
       The name keeps ".HomeScreenSections" because other plugins look the assembly up by that text to register
       sections. RootNamespace stays the upstream one: the embedded resources are found by it. -->
  <PropertyGroup>
    <AssemblyName>Jellyfin.Plugin.HomeScreenSectionsEncore</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.HomeScreenSections</RootNamespace>
  </PropertyGroup>
</Project>
